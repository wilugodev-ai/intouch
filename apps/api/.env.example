PORT=4100
WEB_ORIGIN=http://127.0.0.1:3100
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional WhatsApp integration. Apply 202610220001_whatsapp.sql and complete
# Meta setup first; missing configuration keeps connections disabled.
# Public identifiers (API runtime only, not NEXT_PUBLIC build arguments):
META_APP_ID=
META_WHATSAPP_CONFIG_ID=
META_GRAPH_API_VERSION=
META_PUBLIC_API_ORIGIN=
# Server-only secrets: use Cloud Run Secret Manager references in production.
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
SUPABASE_WHATSAPP_SECRET_KEY=
WHATSAPP_TOKEN_ENCRYPTION_KEY=
# Encryption key must be 32 random bytes encoded as standard base64.
# Create a dedicated Supabase secret key; never reuse .env.test.local credentials.
# After verifying the planned domain and approving cutover: WEB_ORIGIN=https://touchlumo.com
# See docs/touchlumo-launch.md. This example keeps local CORS working.

# Cloud Run uses a private bucket and runtime identity, never downloaded keys.
ATTACHMENTS_BUCKET=
# Development only: defaults to C:/intouch/.data/attachments.
# ATTACHMENTS_LOCAL_DIR=
